@startuml
title Taxi Strategy UML class diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

class Main <<client>> {
  + {static} main(args: String[]): void
}

package "Pricing family" {
  class PricingSelector {
    - source: DemandSource
    + PricingSelector(source: DemandSource)
    + select(ride: Ride): PricingStrategy
    + manual(name: String): PricingStrategy
  }
  class PricingContext {
    - strategy: PricingStrategy
    + PricingContext(strategy: PricingStrategy)
    + setStrategy(strategy: PricingStrategy): void
    + price(ride: Ride): long
  }
  interface PricingStrategy {
    + price(ride: Ride): long
  }
  class StandardPricing {
    + price(ride: Ride): long
  }
  class SurgePricing {
    - source: DemandSource
    - base: StandardPricing
    + SurgePricing(source: DemandSource)
    + price(ride: Ride): long
  }
  class AirportPricing {
    + price(ride: Ride): long
  }
}

package "Driver matching family" {
  class DriverSelector {
    + select(ride: Ride): DriverMatchingStrategy
    + manual(name: String): DriverMatchingStrategy
  }
  class DriverMatchingContext {
    - strategy: DriverMatchingStrategy
    + DriverMatchingContext(strategy: DriverMatchingStrategy)
    + setStrategy(strategy: DriverMatchingStrategy): void
    + match(drivers: List<Driver>): Driver
  }
  interface DriverMatchingStrategy {
    + match(availableDrivers: List<Driver>): Driver
  }
  class NearestDriver {
    + match(availableDrivers: List<Driver>): Driver
  }
  class HighestRatedDriver {
    + match(availableDrivers: List<Driver>): Driver
  }
  class LongestIdleDriver {
    + match(availableDrivers: List<Driver>): Driver
  }
}

package "External data isolation" {
  interface DemandSource {
    + current(): Demand
  }
  class SimulatedDemandSource <<record>> {
    - demand: Demand
    + current(): Demand
  }
  class Demand <<record>> {
    - requests: int
    - availableDrivers: int
    + ratio(): double
  }
}

package "Domain data" {
  class Ride <<record>> {
    - distanceKm: double
    - durationMinutes: int
    - airport: boolean
    - premium: boolean
  }
  class Driver <<record>> {
    - name: String
    - distanceKm: double
    - rating: double
    - idleMinutes: int
  }
}

Main ..> PricingSelector : uses
Main ..> DriverSelector : uses
Main ..> PricingContext : injects / calls
Main ..> DriverMatchingContext : injects / calls

PricingSelector ..> PricingStrategy : returns implementations
DriverSelector ..> DriverMatchingStrategy : returns implementations
PricingContext --> "1" PricingStrategy : strategy
DriverMatchingContext --> "1" DriverMatchingStrategy : strategy

StandardPricing ..|> PricingStrategy
SurgePricing ..|> PricingStrategy
AirportPricing ..|> PricingStrategy
NearestDriver ..|> DriverMatchingStrategy
HighestRatedDriver ..|> DriverMatchingStrategy
LongestIdleDriver ..|> DriverMatchingStrategy

SurgePricing *--> "1" StandardPricing : base
SurgePricing --> "1" DemandSource : source
PricingSelector --> "1" DemandSource : source
SimulatedDemandSource ..|> DemandSource
SimulatedDemandSource --> "1" Demand : demand
DemandSource ..> Demand : returns
PricingStrategy ..> Ride : parameter
DriverMatchingStrategy ..> Driver : input / result

legend bottom
  All 18 production types in package taxi; test classes omitted.
  + public; - private; record accessors and implicit constructors omitted.
  Selectors create concrete strategies; contexts delegate via interfaces.
endlegend
@enduml
